# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: overrides config/instructions.md without a redeploy
# WRITING_INSTRUCTIONS=

# Optional: which Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended: a random string, must match what you pass to
# scripts/set-webhook.js — lets the webhook verify requests really come from Telegram
# TELEGRAM_WEBHOOK_SECRET=
